AML_DB_PATH=/data/aml_memory.db
AML_MARKDOWN_VIEW_DIR=/data/markdown
AML_AUTH_SCHEME=bearer
AML_API_KEY=replace-with-a-long-random-memory-system-key
AML_MAX_TOP_K=100
AML_WORKING_MEMORY_EVENT_LIMIT=40
AML_WORKING_MEMORY_CHAR_LIMIT=16000
AML_MAINTENANCE_EVENT_THRESHOLD=1
AML_MAINTENANCE_CHAR_THRESHOLD=1
AML_ENRICHMENT_MODE=sync
AML_ENRICHMENT_MAX_ATTEMPTS=5
AML_ADD_DEADLINE_SECONDS=120
AML_SEARCH_DEADLINE_SECONDS=30
AML_LLM_ENABLED=false
AML_LLM_MODEL=gpt-4o-mini
AML_ALLOW_NONOFFICIAL_LLM_MODEL=false
OPENAI_BASE_URL=https://api.zhizengzeng.com/v1
OPENAI_API_KEY=
AML_LLM_TIMEOUT_SECONDS=90
AML_LLM_MAX_OUTPUT_TOKENS=2500
AML_LLM_MAX_RETRIES=2
AML_LLM_MAX_CONCURRENCY=16
AML_EMBEDDING_ENABLED=false
AML_EMBEDDING_MODEL=embedding-3
AML_EMBEDDING_DIMENSIONS=512
AML_EMBEDDING_BATCH_SIZE=64
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
AML_EMBEDDING_TIMEOUT_SECONDS=60
AML_EMBEDDING_MAX_RETRIES=2
AML_EMBEDDING_MAX_CONCURRENCY=32
