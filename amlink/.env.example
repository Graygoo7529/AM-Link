# Copy outside tracked source; start with --env-file. No phase-1 env auto-loading.
AML2_DB_PATH=amlink/data/memory.sqlite3
AML2_MODE=graph
AML2_LLM_BASE_URL=https://api.zhizengzeng.com/v1
AML2_LLM_MODEL=gpt-4o-mini
AML2_LLM_API_KEY=
AML2_EMBEDDING_ENABLED=true
AML2_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AML2_EMBEDDING_MODEL=embedding-3
AML2_EMBEDDING_DIMENSIONS=512
AML2_EMBEDDING_API_KEY=
AML2_REFLECTION_THRESHOLD=8
AML2_REFLECTION_CHARS=6000
AML2_BATCH_MESSAGES=32
AML2_BATCH_CHARS=18000
AML2_MAX_BATCHES=64
AML2_REQUEST_SECONDS=1740
AML2_MODEL_TIMEOUT=120
AML2_MODEL_INPUT_CHARS=80000
AML2_SELECT_CANDIDATE_LIMIT=24
AML2_SEARCH_MODEL=true
AML2_MAX_HOPS=3
AML2_AUTH_SCHEME=bearer
AML2_API_KEY=
