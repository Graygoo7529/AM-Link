# Copy outside the release tree, e.g. /etc/amlink/amlink.env; fill secrets locally.
AML3_DB_PATH=/var/lib/amlink/memory.sqlite3
AML3_LLM_BASE_URL=https://api.zhizengzeng.com/v1
AML3_LLM_API_KEY=
AML3_LLM_MODEL=gpt-4o-mini
AML3_EMBEDDING_BASE_URL=https://api.zhizengzeng.com/v1
AML3_EMBEDDING_API_KEY=
AML3_EMBEDDING_MODEL=text-embedding-v4
AML3_EMBEDDING_DIMENSIONS=1024
AML3_AUTH_SCHEME=bearer
AML3_API_KEY=
